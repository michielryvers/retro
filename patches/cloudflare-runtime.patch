+import * as Effect from "effect/Effect";
+import * as Schedule from "effect/Schedule";
+
+/** Cloudflare flags can be wrapped by Alchemy's RpcCallError. */
+export const retryableTransit = (error: unknown): boolean => {
+  let current = error;
+  let retryable = false;
+  const seen = new Set<unknown>();
+  while (current !== null && typeof current === "object" && !seen.has(current)) {
+    seen.add(current);
+    const failure = current as { overloaded?: boolean; retryable?: boolean; cause?: unknown };
+    if (failure.overloaded === true) return false;
+    if (failure.retryable === true) retryable = true;
+    current = failure.cause;
+  }
+  return retryable;
+};
+
+/** Reacquire a stub inside call on every retry; failed stubs may be poisoned. */
+export const transit = <A>(call: () => Effect.Effect<A, unknown>) =>
+  Effect.suspend(call).pipe(
+    Effect.catchDefect((error) => Effect.fail(error)),
+    Effect.retry({
+      while: retryableTransit,
+      schedule: Schedule.min([Schedule.exponential("100 millis"), Schedule.spaced("2 seconds")]),
+      times: 35,
+    }),
+  );
