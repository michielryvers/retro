+// Physical storage cleanup. Business authorization belongs to the application extension.
+const maintenance = (state: DurableObjectState) => ({
+  purge: (manifest: unknown = true) => exclusively(Effect.gen(function* () {
+    yield* Effect.promise(async () => {
+      for (const socket of state.raw.getWebSockets()) socket.close(1008, "This resource was permanently deleted.");
+      await state.raw.storage.deleteAlarm();
+      await state.raw.storage.transaction(async tx => {
+        for (const table of ["alchemy_scheduled_events", "alchemy_alarm_callbacks"]) {
+          if ([...state.raw.storage.sql.exec("SELECT name FROM sqlite_master WHERE type = 'table' AND name = ?", table)].length) {
+            state.raw.storage.sql.exec(`DELETE FROM ${table}`);
+          }
+        }
+        // Bound memory even when event history contains large snapshots.
+        let startAfter: string | undefined;
+        while (true) {
+          const batch = await tx.list({ limit: 32, ...(startAfter ? { startAfter } : {}) });
+          const keys = [...batch.keys()];
+          if (keys.length === 0) break;
+          await tx.delete(keys);
+          startAfter = keys[keys.length - 1];
+        }
+        await tx.put("deleted", manifest);
+      });
+    });
+    return manifest;
+  })),
+  finishPurge: () => state.storage.put("deleted", true),
+});
+const ensurePresent = (state: DurableObjectState) => Effect.gen(function* () {
+  if (yield* state.storage.get("deleted")) return yield* Effect.die(new Error("This resource was permanently deleted."));
+});
