+import * as Effect from "effect/Effect";
+import * as Schedule from "effect/Schedule";
+export const retryableTransit = (error) => {
+    let current = error;
+    let retryable = false;
+    const seen = new Set();
+    while (current !== null && typeof current === "object" && !seen.has(current)) {
+        seen.add(current);
+        const failure = current;
+        if (failure.overloaded === true)
+            return false;
+        if (failure.retryable === true)
+            retryable = true;
+        current = failure.cause;
+    }
+    return retryable;
+};
+export const transit = (call) => Effect.suspend(call).pipe(Effect.catchDefect((error) => Effect.fail(error)), Effect.retry({
+    while: retryableTransit,
+    schedule: Schedule.min([Schedule.exponential("100 millis"), Schedule.spaced("2 seconds")]),
+    times: 35,
+}));
