    "@effect/platform-bun": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@effect/platform-node-shared": "4.0.6",
    "@foldkit/ui": "0.169.0",
    "@foldkit/vite-plugin": "0.28.0",
    "@fontsource-variable/inter": "5.3.0",
    "@noble/hashes": "^2.4.0",
    "@phosphor-icons/web": "2.1.2",
    "@retro/domain": "workspace:*",
    "@retro/server": "workspace:*",
    "@retro/web": "workspace:*",
    "alchemy": "./vendor/alchemy/alchemy.tgz",
    "effect": "4.0.6",
    "foldkit": "0.169.0",
    "jose": "^6.2.13",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "@effect/vitest": "4.0.6",
    "@oxlint/plugins": "1.89.0",
    "@types/bun": "1.4.4",
    "@types/ws": "8.18.2",
    "oxlint": "1.89.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  },
  "trustedDependencies": [
    "workerd",
    "esbuild"
