    "@types/bun": "1.4.4",
    "@types/ws": "8.18.2",
    "oxlint": "1.92.0",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "ws": "8.22.1"
  },
  "trustedDependencies": [
    "workerd",
    "esbuild"
